# Cấu hình đường dẫn cho dữ liệu và thư mục hình ảnh của dự án.
# Bạn có thể sử dụng đường dẫn tương đối (sẽ tự động giải nghĩa tuyệt đối so với thư mục dự án) hoặc đường dẫn tuyệt đối.

# --- Dữ liệu thô (Raw Data) ---
RAW_TRAIN_DATA_PATH=resource/raw-data/train.json
RAW_TEST_DATA_PATH=resource/raw-data/test.json

# --- Dữ liệu đã xử lý (Processed Data) ---
TRAIN_DATA_PATH=resource/data/train.csv
TEST_DATA_PATH=resource/data/test.csv

# --- Dự báo đầu ra ---
PREDICTIONS_OUTPUT_PATH=output/predictions.csv

# --- Kết quả trực quan hóa ---
IMAGES_DIR=output/images

# --- Thư mục bảng kết quả (Tables Output Directory) ---
TABLES_DIR=output/tables

# --- Mô hình và đăng ký mô hình ---
MODELS_DIR=output/models
MODEL_REGISTRY_PATH=output/models/model_registry.json

# --- Checkpoint TabPFN local ---
TABPFN_MODEL_PATH=resource/tabpfn-pretrain/tabpfn-v3-classifier-v3_20260417_binary.ckpt
